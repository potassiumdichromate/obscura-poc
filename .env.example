# .env.example
# Copy to .env and configure

# Miden Configuration
MIDEN_NETWORK=testnet
MIDEN_RPC_ENDPOINT=https://rpc.testnet.miden.io
MIDEN_RPC_TIMEOUT_MS=10000

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Database
DATABASE_URL=sqlite://store.sqlite3

# IPFS
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Logging
RUST_LOG=info,miden_property_platform=debug

# Pinata IPFS Configuration
PINATA_API_KEY=45e4a285be25582c689c
PINATA_SECRET_KEY=5db54dfbd1c7ae06ed82f427579c6f95b4846f718f634c93cba977c22208d09a
